# Supabase Credentials
# Get this from Supabase Project Settings > Database > Connection string (URI).
# Use the pooler host/port shown there (6543 = transaction mode, 5432 = session mode).
DATABASE_URL=postgresql://postgres.xxxxxx:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Django Settings
SECRET_KEY=django-insecure-secret-key-change-me
DEBUG=True
# Use "*" during local development so a phone/emulator hitting the server via
# your machine's LAN IP isn't rejected with DisallowedHost. Restrict this to
# real hostnames in production.
ALLOWED_HOSTS=*

# Shared secret the ESP32 sends when posting sensor readings (must match the
# DEVICE_API_KEY value hardcoded in ESP32/sensor.cpp).
DEVICE_API_KEY=change-me-device-key
